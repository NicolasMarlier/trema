#!/bin/bash

random_postgres_user() {
    echo $(tr -dc '[:alpha:]' < /dev/urandom | head -c 10)
}

random_postgres_password() {
    echo $(tr -dc '[:alpha:]' < /dev/urandom | head -c 10)
}

sanitize_subdomain() {
    echo "${1//_/-}"
}

echo "Deployment will start..."
DEPLOY_START=$(date +%s)



REPO_DIR=$PWD
APP_NAME=$(basename "$REPO_DIR")
WORK_TREE=$(dirname $(dirname $REPO_DIR))/apps/$APP_NAME
DOCKER_FILES_DIR=$(dirname $(dirname $REPO_DIR))/docker_compose_files

echo "🚀 Deploying $APP_NAME..."

# Create working tree if not exists
mkdir -p "$WORK_TREE"

# Checkout latest code
git --work-tree="$WORK_TREE" --git-dir="$REPO_DIR" checkout -f



# Root directory (monorepo): detection and docker compose run from that sub-directory.
ROOT_DIR=$(git --git-dir="$REPO_DIR" config --get trema.rootdir 2>/dev/null | sed 's#^/*##; s#/*$##')
case "$ROOT_DIR" in .|..|../*|*/..|*/../*) ROOT_DIR="" ;; esac
if [ -n "$ROOT_DIR" ]; then
    if ! git --git-dir="$REPO_DIR" cat-file -e "HEAD:$ROOT_DIR" 2>/dev/null; then
        echo "❌ Root directory '$ROOT_DIR' not found in this commit, deployment aborted."
        exit 1
    fi
    echo "Root directory: $ROOT_DIR"
    # Two apps built from the same repo must not share containers.
    export COMPOSE_PROJECT_NAME="$APP_NAME"
    COMPOSE_DIR="$WORK_TREE/$ROOT_DIR"
    GIT_PREFIX_PATH="$ROOT_DIR/"
else
    COMPOSE_DIR="$WORK_TREE"
    GIT_PREFIX_PATH=""
fi
DEPLOY_SOURCE="${TREMA_SOURCE:-push}"

cd "$COMPOSE_DIR"


# An app shipping its own docker-compose.yml (with a `web` service listening on 3000)
# is deployed as-is. Otherwise, fall back to the Rails + Postgres template.
if git --git-dir="$REPO_DIR" cat-file -e "HEAD:${GIT_PREFIX_PATH}docker-compose.yml" 2>/dev/null; then
    CUSTOM_COMPOSE=1
    echo "Detected app-provided docker-compose.yml"
else
    CUSTOM_COMPOSE=0
fi

if [ -f ".env" ]; then
    echo "Not the first deploy..."
elif [ "$CUSTOM_COMPOSE" = "1" ]; then
    echo "First deploy: creating .env from .env.example (edit it with 'trema env')..."
    if [ -f ".env.example" ]; then cp .env.example .env; else touch .env; fi
else
    echo "Detecting Ruby on Rails app, populating .env file..."
    cat <<EOF > .env
LANG=en_US.UTF-8
RACK_ENV=production
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=enabled
POSTGRES_USER=$(random_postgres_user)
POSTGRES_PASSWORD=$(random_postgres_password)
POSTGRES_DB=$APP_NAME
EOF
fi


echo "🐳 Building and restarting containers..."

if [ "$CUSTOM_COMPOSE" = "0" ]; then
    cp $DOCKER_FILES_DIR/RoR_3_4_8_Puma.Dockerfile "$COMPOSE_DIR/Dockerfile"
    cp $DOCKER_FILES_DIR/ruby_on_rails_postgres.yml "$COMPOSE_DIR/docker-compose.yml"
fi

# Append to deploys.log (read by the Trema UI): date<TAB>commit<TAB>duration<TAB>result<TAB>commit message<TAB>source (always at the app root, not the root directory)
log_deploy() {
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$(git --git-dir="$REPO_DIR" rev-parse --short HEAD)" "$(( $(date +%s) - DEPLOY_START ))" "$1" "$(git --git-dir="$REPO_DIR" log -1 --format=%s HEAD | tr '\t\r\n' '   ' | cut -c1-200)" "$DEPLOY_SOURCE" >> "$WORK_TREE/deploys.log"
}

if [ "$CUSTOM_COMPOSE" = "0" ]; then
    echo "🗄️  Running database migrations..."
    if ! docker compose --env-file .env build \
        || ! docker compose --env-file .env up -d --wait db \
        || ! docker compose --env-file .env run --rm web bin/rails db:prepare; then
        echo "❌ Migration failed, deployment aborted (previous version still running)."
        log_deploy failed
        exit 1
    fi
fi

if docker compose --env-file .env up --build --force-recreate -d; then
    DEPLOY_RESULT=ok
else
    DEPLOY_RESULT=failed
fi
log_deploy "$DEPLOY_RESULT"


WEB_PORT=$(docker compose port web 3000 | cut -d: -f2)
grep -q '^WEB_PORT=' .env 2>/dev/null || echo "WEB_PORT=$WEB_PORT" >> .env

SUBDOMAIN=$(sanitize_subdomain "$APP_NAME")

sed -i "/proxy_pass/c\proxy_pass http://localhost:$WEB_PORT;" /etc/nginx/sites-enabled/$SUBDOMAIN
systemctl reload nginx
echo "Applicating listening locally on: $WEB_PORT"

URL=$(grep -oP 'server_name\s+\K[^;]+' /etc/nginx/sites-enabled/$SUBDOMAIN)

echo "✅ Deployment complete, your app is available on: https://$URL"

