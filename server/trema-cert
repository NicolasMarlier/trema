#!/bin/bash
# Installed as /usr/local/sbin/trema-cert (root:root 755), run via `sudo -n` by the trema user.
# Usage: trema-cert <domain>. Only accepts <label>.<host> where <host> is the one in /etc/trema/host.
set -e
ROOT="${TREMA_ROOT:-}"
[[ $# -eq 1 ]] || { echo "Usage: trema-cert <domain>" >&2; exit 2; }
domain="$1"
HOST_FILE="$ROOT/etc/trema/host"
[[ -r "$HOST_FILE" ]] || { echo "trema-cert: $HOST_FILE missing (run 'trema server:setup')" >&2; exit 2; }
host=$(head -1 "$HOST_FILE" | tr -d '[:space:]')
[[ "$host" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]] || { echo "trema-cert: invalid host in $HOST_FILE" >&2; exit 2; }
label_re='[a-z0-9]([a-z0-9-]*[a-z0-9])?'
if ! [[ "$domain" =~ ^${label_re}\.${host//./\\.}$ ]]; then
    echo "trema-cert: refused domain '$domain' (expected <name>.$host)" >&2
    exit 2
fi
if [[ -n "$TREMA_CERT_DRY_RUN" ]]; then echo "certbot --nginx --non-interactive --domains $domain"; exit 0; fi
exec /usr/bin/certbot --nginx --non-interactive --domains "$domain"
