#!/bin/bash
source "$(dirname "${BASH_SOURCE[0]}")/trema-config"

usage() {
    echo "Usage:
    trema logs [--tail N]
    trema ssh
    trema console
    trema server:setup
    trema destroy
    trema env
    trema migrate
    trema ui:install      # installs the UI and exposes it on https://trema.<host> (password + TOTP)
    trema ui:password     # change the password (closes all sessions)
    trema load_pg_dump #pg_dump_file.sql
    trema heroku_pg_dump
    trema config [--help]
    trema config:edit

App commands (logs, console, env, migrate, destroy, update, load_pg_dump, archive_db,
heroku_pg_dump) take the app from the 'trema' git remote, or from --app <name>.
"
}

docker_container_name() {
    echo "$TREMA_PROJECT_NAME-web-1"
}

logs() {
    local tail_opt=""
    if [[ "$1" == "--tail" ]]; then
        [[ "$2" =~ ^[0-9]+$ ]] || { echo "Usage: trema logs --tail N" >&2; exit 1; }
        tail_opt="--tail $2"
    fi
    do_ssh "docker logs -f $tail_opt $(docker_container_name)"
}

server_setup() {
    rsync -r "$(trema_path)/server" $TREMA_USERNAME@$TREMA_HOSTNAME:~/trema_server
    do_ssh "sudo bash ~/trema_server/server/setup.sh"
}

do_ssh() {
    ssh -t $TREMA_USERNAME@$TREMA_HOSTNAME $1
}

sanitize_subdomain() {
    echo "${1//_/-}"
}

heroku_pg_dump() {
    echo "Getting production credentials..."
    POSTGRES_URL=$(heroku config:get DATABASE_URL)
    FILENAME=data/$TREMA_PROJECT_NAME-dump-$(date '+%Y-%m-%dT%H%M').sql
    echo "Dumping production data..."
    pg_dump --data-only --dbname=$POSTGRES_URL > $FILENAME
    echo "Dump stored in $FILENAME"
}

destroy() {
    SUBDOMAIN=$(sanitize_subdomain "$TREMA_PROJECT_NAME")
    do_ssh "cd apps/$TREMA_PROJECT_NAME && docker compose down --volumes"
    do_ssh "rm -rf repos/$TREMA_PROJECT_NAME"
    do_ssh "rm -rf apps/$TREMA_PROJECT_NAME"
    do_ssh "rm -rf envs/$TREMA_PROJECT_NAME.env"
    do_ssh "rm /etc/nginx/sites-enabled/$SUBDOMAIN"
    do_ssh "systemctl restart nginx"
    git remote remove trema 2>/dev/null
}

# Removes a legacy trema.env from the current folder (no longer used).
cleanup_legacy_env() {
    [[ -f trema.env ]] || return 0
    local diff=""
    if [[ -f "$GLOBAL_CONFIG" ]]; then
        local k v
        while IFS='=' read -r k v; do
            [[ "$k" == TREMA_HOSTNAME || "$k" == TREMA_USERNAME ]] || continue
            [[ "$v" == "$(grep "^$k=" "$GLOBAL_CONFIG" | head -1 | cut -d= -f2-)" ]] || diff+="    $k=$v"$'\n'
        done < trema.env
    fi
    if [[ -n "$diff" ]]; then
        echo "⚠ Removed trema.env, which differed from ~/.trema_config:" >&2
        printf '%s' "$diff" >&2
    else
        echo "🧹 Removed trema.env (no longer used, config comes from ~/.trema_config)" >&2
    fi
    rm -f trema.env
}

# Global commands: only need ~/.trema_config.
load_env() {
    cleanup_legacy_env
    load_global_config
}

# App commands: global config + app name (--app, else the 'trema' remote).
load_app_env() {
    load_env
    local url host
    url=$(trema_remote_url)
    if [[ -n "$url" ]]; then
        host="${url#*@}"; host="${host%%:*}"
        if [[ "$host" != "$TREMA_HOSTNAME" ]]; then
            echo "Error: remote 'trema' points to $host, but ~/.trema_config uses $TREMA_HOSTNAME." >&2
            echo "Multiple VMs are not supported. Update the remote or ~/.trema_config." >&2
            exit 1
        fi
    fi
    if [[ -z "$TREMA_APP_OVERRIDE" ]]; then
        if [[ "$url" != *:repos/* ]]; then
            echo "Error: no Trema app here (no 'trema' git remote)." >&2
            echo "Create it in the UI (https://trema.<host>), or pass --app <name>." >&2
            exit 1
        fi
        TREMA_PROJECT_NAME="${url##*:repos/}"; TREMA_PROJECT_NAME="${TREMA_PROJECT_NAME%.git}"
    else
        TREMA_PROJECT_NAME="$TREMA_APP_OVERRIDE"
    fi
}

trema_path() {
    # Code of the checkout this script lives in (resolves symlinks), not a PATH copy.
    local src="${BASH_SOURCE[0]}"
    while [[ -L "$src" ]]; do
        local dir; dir="$(cd "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"; [[ "$src" == /* ]] || src="$dir/$src"
    done
    dirname "$(cd "$(dirname "$src")" && pwd)"
}
    
update() {
    rsync -r $(trema_path)/docker_compose_files $TREMA_USERNAME@$TREMA_HOSTNAME:~
    server_setup
    rsync -r $(trema_path)/hooks $TREMA_USERNAME@$TREMA_HOSTNAME:repos/$TREMA_PROJECT_NAME
}

migrate() {
    do_ssh "cd apps/$TREMA_PROJECT_NAME && docker compose --env-file .env run --rm web bin/rails db:prepare"
}

sync_db() {
    PG_DUMP_FILE_PATH=$1
    echo "Will load $PG_DUMP_FILE_PATH file DB..."

    PG_DUMP_FILE_NAME=$(basename "$PG_DUMP_FILE_PATH")

    rsync ${PG_DUMP_FILE_PATH} ${TREMA_USERNAME}@${TREMA_HOSTNAME}:/db_dumps/${PG_DUMP_FILE_NAME}
    


    do_ssh "docker exec ${TREMA_PROJECT_NAME}-db-1 sh -c 'PGPASSWORD=\$POSTGRES_PASSWORD psql -U \$POSTGRES_USER \$POSTGRES_DB < /db_dumps/${PG_DUMP_FILE_NAME}'"

    echo "Done."
}

archive_db() {
    mkdir -p data
    PG_DUMP_FILE_NAME="trema-${TREMA_PROJECT_NAME}-$(date '+%Y-%m-%dT%H%M').sql"
    do_ssh "docker exec ${TREMA_PROJECT_NAME}-db-1 sh -c 'PGPASSWORD=\$POSTGRES_PASSWORD pg_dump --data-only -U \$POSTGRES_USER \$POSTGRES_DB > /db_dumps/${PG_DUMP_FILE_NAME}'"
    rsync ${TREMA_USERNAME}@${TREMA_HOSTNAME}:/db_dumps/${PG_DUMP_FILE_NAME} data/${PG_DUMP_FILE_PATH}

    echo "Saved in data/$PG_DUMP_FILE_NAME"
}

console() {
    do_ssh "docker exec -it $TREMA_PROJECT_NAME-web-1 /bin/bash"
}

env() {
    do_ssh "cd apps/$TREMA_PROJECT_NAME && vim .env && docker compose --env-file .env up --build --force-recreate -d"
}

ui_domain() { echo "trema.$TREMA_HOSTNAME"; }

# Reads a password (twice) into UI_PASSWORD.
ask_ui_password() {
    local p1 p2
    read -rsp "UI password (12 characters min.): " p1; echo
    read -rsp "Confirm: " p2; echo
    [[ "$p1" == "$p2" ]] || { echo "Passwords differ." >&2; return 1; }
    [[ ${#p1} -ge 12 ]] || { echo "Password too short." >&2; return 1; }
    UI_PASSWORD="$p1"
}

ui_set_password() {
    local out
    out=$(printf '%s\n' "$UI_PASSWORD" | do_ssh "node ~/trema-ui/ui/auth-cli.mjs ~/trema-ui/auth.json set-password $(ui_domain)") || return 1
    echo "$out" | grep '^TOTP_' | sed 's/^/   /'
    if echo "$out" | grep -q '^TOTP_SECRET='; then
        echo "   Add this secret in Google Authenticator (\"Enter a setup key\", time-based) or open the URI."
    fi
}

ui_nginx_config() {
    local domain; domain=$(ui_domain)
    cat <<EOF > tmp-nginx-config
limit_req_zone \$binary_remote_addr zone=trema_login:1m rate=10r/m;
server {
    server_name $domain;

    location = /api/login {
        limit_req zone=trema_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-For \$remote_addr;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-For \$remote_addr;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_buffering off;
    }
}
EOF
    rsync tmp-nginx-config $TREMA_USERNAME@$TREMA_HOSTNAME:/tmp/trema-ui-nginx && rm tmp-nginx-config
    do_ssh "sudo mv /tmp/trema-ui-nginx /etc/nginx/sites-enabled/trema-ui && sudo certbot --nginx --non-interactive --domains $domain && sudo systemctl reload nginx"
}

ui_install() {
    # Build the React bundle locally; the server only receives static files (no node_modules).
    (cd "$(trema_path)/ui/web" && npm install --no-audit --no-fund && npm run build) || { echo "❌ UI build failed"; exit 1; }
    rsync -r --delete --exclude node_modules --exclude web $(trema_path)/ui $(trema_path)/hooks $(trema_path)/package.json $TREMA_USERNAME@$TREMA_HOSTNAME:trema-ui/
    # Lets the UI create apps (certbot needs root): only these two commands, without password.
    do_ssh "printf '%s ALL=(root) NOPASSWD: /usr/bin/certbot --nginx --non-interactive --domains *, /usr/bin/systemctl reload nginx\n' \"\$USER\" | sudo tee /etc/sudoers.d/trema-ui >/dev/null && sudo chmod 440 /etc/sudoers.d/trema-ui && sudo visudo -cf /etc/sudoers.d/trema-ui >/dev/null || { sudo rm -f /etc/sudoers.d/trema-ui; echo '❌ invalid sudoers rule' >&2; exit 1; }"
    if ! do_ssh "test -f ~/trema-ui/auth.json"; then
        ask_ui_password || exit 1
        ui_set_password || exit 1
    fi
    do_ssh "sed -e \"s|__USER__|\$USER|g\" -e \"s|__HOME__|\$HOME|g\" ~/trema-ui/ui/trema-ui.service | sudo tee /etc/systemd/system/trema-ui.service >/dev/null && sudo systemctl daemon-reload && sudo systemctl enable trema-ui && sudo systemctl restart trema-ui"
    ui_nginx_config
    echo "✅ Trema UI installed (systemd, restarts on boot). Open https://$(ui_domain)"
}

ui_password() {
    ask_ui_password || exit 1
    ui_set_password || exit 1
    do_ssh "sudo systemctl restart trema-ui"
    echo "✅ Password changed, all sessions closed"
}

# Allow sourcing (bin/trema-deploy) without running the dispatcher.
[[ "${BASH_SOURCE[0]}" != "$0" ]] && return 0

# Extract --app <name> from the arguments.
ARGS=()
while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--app" ]]; then
        [[ -n "$2" ]] || { echo "Usage: --app <name>" >&2; exit 1; }
        TREMA_APP_OVERRIDE="$2"; shift 2
    else
        ARGS+=("$1"); shift
    fi
done
set -- "${ARGS[@]}"

case "$1" in
    config) config "$2" ;;
    config:edit) config_edit_cmd "$2" ;;

    ssh) load_env; do_ssh ;;
    server:setup) load_env; server_setup ;;
    ui:install) load_env; ui_install ;;
    ui:password) load_env; ui_password ;;

    destroy) load_app_env; destroy ;;
    console) load_app_env; console ;;
    logs) load_app_env; shift; logs "$@" ;;
    update) load_app_env; update ;;
    env) load_app_env; env ;;
    migrate) load_app_env; migrate ;;
    heroku_pg_dump) load_app_env; heroku_pg_dump ;;
    archive_db) load_app_env; archive_db ;;
    load_pg_dump) load_app_env; sync_db $2 ;;
    *) usage ;;
esac
