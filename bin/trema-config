#!/bin/bash
GLOBAL_CONFIG="$HOME/.trema_config"

# Loads TREMA_HOSTNAME / TREMA_USERNAME from ~/.trema_config or exits with an error.
load_global_config() {
    if [[ ! -f "$GLOBAL_CONFIG" ]]; then
        echo "Error: $GLOBAL_CONFIG not found." >&2
        echo "Run 'trema config:edit --global'." >&2
        exit 1
    fi
    source "$GLOBAL_CONFIG"
    if [[ -z "$TREMA_HOSTNAME" || -z "$TREMA_USERNAME" ]]; then
        echo "Error: $GLOBAL_CONFIG missing TREMA_HOSTNAME / TREMA_USERNAME." >&2
        echo "Run 'trema config:edit --global'." >&2
        exit 1
    fi
}

# Prints the remote 'trema' URL (empty if none).
trema_remote_url() { git remote get-url trema 2>/dev/null; }

config_help() {
    echo "Usage:
    trema config                  Display the global config (~/.trema_config) and the detected app
    trema config:edit             Edit the global config
    trema config --help           Show this help message
(--global is accepted as an alias.)
"
}

config_show() {
    if [[ -f "$GLOBAL_CONFIG" ]]; then
        echo "Global config ($GLOBAL_CONFIG):"
        cat "$GLOBAL_CONFIG"
    else
        echo "No global config found. Run 'trema config:edit --global' to create one."
    fi
    local url; url=$(trema_remote_url)
    if [[ "$url" == *:repos/* ]]; then
        echo "Current app: ${url##*:repos/} (git remote trema)"
    fi
}

config_edit() {
    mkdir -p "$(dirname "$GLOBAL_CONFIG")"
    ${EDITOR:-vi} "$GLOBAL_CONFIG"
}

config() {
    case "$1" in
        --help) config_help ;;
        ""|--global) config_show ;;
        *) config_help; exit 1 ;;
    esac
}

config_edit_cmd() {
    case "$1" in
        ""|--global) config_edit ;;
        *) config_help; exit 1 ;;
    esac
}
